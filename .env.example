# Copy to .env and set WIZ_BULB_IP. Every other setting has a working default,
# so a minimal .env needs only that one line.
#
# Values already present in the process environment take precedence over this
# file, so a deployment can override any of these without editing it.

# --- Bulb -------------------------------------------------------------------

# Address of the bulb to control. REQUIRED; there is no default.
WIZ_BULB_IP=192.168.1.42

# UDP port of the bulb. Default: 38899.
# 38899 is pywizlight's actual default port. Its README documents 12345,
# which is wrong -- do not "correct" this to 12345.
#WIZ_BULB_PORT=38899

# Seconds between presence polls. The poll both tracks whether the bulb is
# reachable and refreshes the cached state. Default: 30.
#WIZ_POLL_INTERVAL_SECONDS=30

# Timeout in seconds for a single request to the bulb. Default: 5.
#WIZ_REQUEST_TIMEOUT_SECONDS=5

# --- MCP server -------------------------------------------------------------

# Address to bind. Default: 127.0.0.1 (loopback only, not exposed on the
# network). Set to 0.0.0.0 to accept connections from other machines -- and
# then MCP_ALLOWED_HOSTS must be set too, see below.
#MCP_HOST=127.0.0.1

# Port to bind. Default: 8000.
#MCP_PORT=8000

# HTTP path the MCP endpoint is served on. Default: /mcp.
#MCP_PATH=/mcp

# Comma-separated host values accepted in incoming requests. Default: empty.
# DNS-rebinding protection is enabled by default, so once MCP_HOST is not
# loopback, requests are rejected on their Host header until the hosts you
# connect as are listed here. Leaving this empty with a non-loopback bind
# produces a server that looks healthy but refuses every remote request.
# Example: MCP_ALLOWED_HOSTS=porch.local:8000,192.168.1.10:8000
#MCP_ALLOWED_HOSTS=
