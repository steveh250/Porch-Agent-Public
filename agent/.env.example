# Copy to .env (never committed). Values already in the environment win.

# OpenRouter key for the decision agent. Without it every arrival uses the fallback.
OPENROUTER_API_KEY=

# OpenWeatherMap key (free tier is plenty with the 10-minute cache).
# Without it every arrival uses the fallback.
OWM_API_KEY=

# Only if your Mosquitto broker requires a password (set mqtt.username in config.yaml).
#MQTT_PASSWORD=
